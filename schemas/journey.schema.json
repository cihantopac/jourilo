{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cihantopac/jourilo/main/schemas/journey.schema.json",
  "title": "Jourilo journey",
  "type": "object",
  "required": ["version", "id", "name", "start", "steps", "success"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "goal": { "type": "string" },
    "persona": { "type": "string" },
    "start": { "type": "string" },
    "viewport": { "type": "string" },
    "source": { "enum": ["suggested", "user", "agent"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "safety": {
      "type": "object",
      "properties": { "submitsForms": { "type": "boolean" }, "destructive": { "type": "boolean" } },
      "additionalProperties": false
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "success": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } }
  },
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "text": { "type": "string" },
        "placeholder": { "type": "string" },
        "testId": { "type": "string" },
        "css": { "type": "string" },
        "exact": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["role"] },
        { "required": ["label"] },
        { "required": ["text"] },
        { "required": ["placeholder"] },
        { "required": ["testId"] },
        { "required": ["css"] }
      ]
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "enum": [
            "goto",
            "click",
            "fill",
            "select",
            "check",
            "press",
            "hover",
            "wait",
            "back",
            "expect",
            "screenshot"
          ]
        },
        "url": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "value": { "type": "string" },
        "key": { "type": "string" },
        "ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "visible": { "$ref": "#/$defs/target" },
        "hidden": { "$ref": "#/$defs/target" },
        "title": { "type": "string" },
        "name": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "url": { "type": "string" },
        "urlNot": { "type": "string" },
        "visible": { "$ref": "#/$defs/target" },
        "noPageErrors": { "type": "boolean" },
        "noFailedRequests": { "type": "boolean" }
      }
    }
  }
}
