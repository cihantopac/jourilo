{
  "description": "Form grouping, data tables, image alternatives and redirects: broken and accessible versions.",
  "mustFind": [
    {
      "rule": "jourilo/fieldset-legend",
      "path": "/broken",
      "why": "fieldset without legend and with an empty legend"
    },
    {
      "rule": "jourilo/fieldset-legend",
      "path": "/named",
      "evidenceExactly": [
        "#ctl-unresolved",
        "#ctl-blank"
      ],
      "why": "aria-labelledby that resolves to nothing and a blank aria-label are not names; the aria-label and resolving aria-labelledby fieldsets are"
    },
    {
      "rule": "jourilo/radio-group",
      "path": "/broken",
      "why": "radio pair not grouped"
    },
    {
      "rule": "jourilo/table-headers",
      "path": "/broken",
      "why": "3x2 data table with td only"
    },
    {
      "rule": "jourilo/empty-alt-with-title",
      "path": "/broken",
      "why": "alt=\"\" with a descriptive title"
    },
    {
      "rule": "jourilo/keyboard-trap",
      "path": "/trap-async",
      "kind": "defect",
      "why": "onblur refocus after a timeout (ACT 80af7b)"
    },
    {
      "rule": "jourilo/keyboard-trap",
      "path": "/trap-documented",
      "kind": "needs-review",
      "why": "held focus with a documented, working Ctrl+M exit"
    },
    {
      "rule": "jourilo/contrast-over-image",
      "path": "/banner",
      "kind": "defect",
      "evidenceExactly": [
        "ctl-banner"
      ],
      "why": "visible text over a background image is still reported (F25); pixel sampling now decides it: #6b7280 on #bbf7d0 is about 4:1, under 4.5:1 (F8)"
    },
    {
      "rule": "jourilo/redirect-chain",
      "path": "/old",
      "kind": "defect",
      "why": "/old \u2192 /older \u2192 /oldest \u2192 /new: three redirects before the page (Frameva, field item F23)"
    },
    {
      "rule": "jourilo/button-implicit-submit",
      "path": "/implicit-submit",
      "kind": "defect",
      "evidenceExactly": [
        "#show-pw"
      ],
      "why": "a Show password button with no type submits the login form; the Sign in button is a submit button by name"
    }
  ],
  "mustNotFind": [
    {
      "rule": "jourilo/fieldset-legend",
      "path": "/accessible"
    },
    {
      "rule": "jourilo/radio-group",
      "path": "/accessible"
    },
    {
      "rule": "jourilo/table-headers",
      "path": "/accessible",
      "why": "header cells, and a layout table with role=presentation"
    },
    {
      "rule": "jourilo/empty-alt-with-title",
      "path": "/accessible"
    },
    {
      "rule": "jourilo/keyboard-trap",
      "path": "/trap-documented",
      "kind": "defect",
      "why": "WCAG 2.1.2 allows a documented way out that works"
    },
    {
      "rule": "axe-review/color-contrast",
      "path": "/glyphs",
      "why": "aria-hidden decorative glyphs in a fallback font are not read as text (F25)"
    },
    {
      "rule": "jourilo/redirect-chain",
      "path": "/moved",
      "why": "a single 301 to the new address is normal"
    },
    {
      "rule": "jourilo/button-implicit-submit",
      "path": "/implicit-submit",
      "evidenceExactly": [
        "#ctl-sign-in"
      ],
      "why": "a typeless Sign in button is the form's submit button by name"
    }
  ],
  "maxDefects": {
    "minSeverity": "moderate",
    "count": 0,
    "paths": [
      "/accessible",
      "/moved"
    ]
  },
  "audit": {
    "maxPages": 12
  }
}
